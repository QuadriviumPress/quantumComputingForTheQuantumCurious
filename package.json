{
  "name": "quantum-computing-for-the-quantum-curious",
  "version": "1.0.0",
  "private": true,
  "description": "MyST Markdown edition of Quantum Computing for the Quantum Curious",
  "license": "CC-BY-4.0",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "myst start",
    "build": "myst build --html && node scripts/setup-pwa.mjs",
    "verify": "python3 scripts/verify_book.py",
    "check": "npm run verify && myst build --html --strict --check-links",
    "build:pdf": "scripts/build-pdf.sh"
  },
  "devDependencies": {
    "mystmd": "1.12.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
